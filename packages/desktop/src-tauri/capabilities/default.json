{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "openwork-default",
  "description": "Default OpenWork capability (UI permissions)",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPLOCALDATA/openwork/**",
        "$APPLOCALDATA/forge/**"
      ]
    },
    "core:webview:allow-set-webview-zoom",
    "deep-link:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "shell:allow-execute",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": ["-c", { "validator": ".*" }],
          "cmd": "sh",
          "name": "exec-sh",
          "sidecar": false
        },
        {
          "args": ["/C", { "validator": ".*" }],
          "cmd": "cmd",
          "name": "exec-cmd",
          "sidecar": false
        },
        {
          "args": true,
          "cmd": "git",
          "name": "exec-git",
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" }
      ]
    }
  ]
}
